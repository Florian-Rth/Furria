# Copy to .env next to docker-compose.yml and fill in. Consumed by docker-compose.example.yml.

# Docker Hub namespace CI pushes images to (your username or org).
DOCKERHUB_USERNAME=your-dockerhub-username

# PostgreSQL credentials - shared by the database and the API connection string.
POSTGRES_USER=furria
POSTGRES_PASSWORD=change-me
POSTGRES_DB=furria

# Preview-access gate password (empty denies all preview access).
PREVIEW_ACCESS_PASSWORD=

# Website API origin. Leave empty for same-origin (nginx proxies /api to the api service).
# Set to an absolute URL only if the browser must reach the API on a different host.
WEBSITE_API_BASE_URL=

# Host port the website is published on.
WEBSITE_PORT=80

# Club-App API origin. Leave empty for same-origin (nginx proxies /api to the api service).
CLUB_APP_API_BASE_URL=

# Host port the club-app is published on (app.furria.de terminates in front of this).
CLUB_APP_PORT=8081

# Address the TLS edge's traffic arrives from on this host (the gateway it comes through). The API
# trusts its X-Forwarded-For / -Proto - so anything reaching the host through it could claim an
# address. An IP or a CIDR network.
EDGE_PROXY_ADDRESS=10.10.20.1

# JWT signing key for access tokens - at least 32 characters, the API refuses to start otherwise.
AUTH_SIGNING_KEY=

# Key that signs the proof-of-work challenges of the website's membership application (self-hosted
# Altcha, no third party) - at least 32 characters, the API refuses to start otherwise. Changing it
# voids only the challenges issued in the last 10 minutes.
ALTCHA_HMAC_KEY=

# The managing login (ADR-0022): every start brings it in line with these two values and recreates
# it when gone; leave empty to skip it. Password needs at least 12 characters plus upper/lower
# case, a digit and a symbol (ASP.NET Identity complexity rules).
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# SMTP the API sends invitations and notices through (plain SMTP, no provider API).
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# The club's domain (e.g. furria.de): the website lives on it, the club-app on app.<domain>, and
# passkeys belong to it (ADR-0020) - passkeys made under another domain stop working on a move.
CLUB_DOMAIN=
# Optional: the club-app's host when it is not app.<CLUB_DOMAIN>; must lie under CLUB_DOMAIN.
# Interim before the club domain exists: CLUB_DOMAIN=florianrth.com, CLUB_APP_HOST=furria-app.florianrth.com
CLUB_APP_HOST=
# Optional: the website's host when it is not <CLUB_DOMAIN> itself. Mailed links that open the website
# (a membership application's confirmation) start here. Interim: the florianrth.com host the website
# runs on.
WEBSITE_HOST=

# Android app the club-app's and the website's /.well-known/assetlinks.json vouch for (App Links,
# passkeys).
ANDROID_PACKAGE_NAME=de.furria.club
# SHA-256 signing-certificate fingerprints, comma-separated, as keytool prints them (AB:CD:...).
# Feeds both assetlinks.json files and the API's accepted passkey origins.
# Debug and release keys differ; list both while both are installed. Empty = no assetlinks.json
# and no passkeys inside the Android app.
ANDROID_CERT_FINGERPRINTS=
