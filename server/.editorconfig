root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{xml,csproj,props,targets,json,yaml,yml,slnx}]
indent_size = 2

[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# MET006: production code never reads the ambient clock - inject TimeProvider.
dotnet_diagnostic.MET006.severity = error

# CA2254: log message templates are constant strings - no interpolation, no concatenation.
dotnet_diagnostic.CA2254.severity = error

# MET008-MET010: production code logs through ILogger<T>, with PascalCase placeholders that name
# no personal data (ADR-0017).
dotnet_diagnostic.MET008.severity = error
dotnet_diagnostic.MET009.severity = error
dotnet_diagnostic.MET010.severity = error
