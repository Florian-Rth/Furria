# The TLS edge in front of this nginx states the scheme the browser used; $scheme is only the
# fallback for a request that reached this nginx directly.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    resolver 127.0.0.11 valid=10s ipv6=off;

    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript application/json application/xml image/svg+xml text/plain;

    include /etc/nginx/snippets/security-headers.conf;

    location = /config.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store";
        try_files $uri =404;
    }

    location = /.well-known/assetlinks.json {
        types { }
        default_type application/json;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=300";
        try_files $uri =404;
    }

    location ^~ /.well-known/ {
        try_files $uri =404;
    }

    location /api/ {
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    # A failed page-head read must add nothing to the <head> it is included into.
    location ^~ /api/public/page-heads/ {
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_intercept_errors on;
        error_page 400 404 500 502 503 504 = @no_page_head;
    }

    location @no_page_head {
        return 204;
    }

    # Sitemap of the API-driven pages (events, news, albums), next to the build's sitemap-pages.xml.
    location = /sitemap-content.xml {
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream/api/public/sitemap.xml;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }

    location ^~ /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # API-driven detail pages: the API renders their <head> into the SPA shell (SSI), so link
    # previews and crawlers that run no JavaScript still get title, description and share image.
    location ~ "^(?<content_page>/(events|news|gallery)/[a-z0-9-]+)$" {
        ssi on;
        ssi_silent_errors on;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files /content-page-shell.html =404;
    }

    location = / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }

    # Static pages are prerendered to <path>/index.html; every other path gets the noindex shell.
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/index.html /app-shell.html;
    }
}
